# Supabase project - Settings -> API Keys / Data API.
# The anon/public key is safe to embed client-side (RLS protects the data).
EXPO_PUBLIC_SUPABASE_URL=https://syuhjdkoyqpuvgareiye.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key

# Spring Boot backend base URL (no trailing slash). Optional in dev: leave it unset and
# src/lib/env.ts derives http://<metro-host>:8080, which is correct for a physical device
# on the same network without hardcoding a LAN IP that changes with every DHCP lease.
# Set it to override that, e.g.:
# - Android Emulator: http://10.0.2.2:8080
# - Production: https://ryddig-kollektiv-backend.onrender.com
# EXPO_PUBLIC_API_URL=http://localhost:8080

# RevenueCat project -> API Keys -> Apple App Store. Optional: the app runs fine without
# it, but any purchase attempt fails with a clear "not configured" error until it's set.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=replace-with-revenuecat-ios-api-key
