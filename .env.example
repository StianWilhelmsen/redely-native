# Auth0 "Native" application (NOT the Regular Web Application used by the Next.js app).
# Create one at https://manage.auth0.com -> Applications -> Create Application -> Native.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=replace-with-native-app-client-id

# Same Auth0 API audience the Spring Boot backend and Next.js app already use.
EXPO_PUBLIC_AUTH0_AUDIENCE=replace-with-api-audience

# Spring Boot backend base URL (no trailing slash).
# - iOS Simulator: http://localhost:8080
# - Android Emulator: http://10.0.2.2:8080
# - Physical device: http://<your-computer-LAN-IP>:8080
# - Production: https://ryddig-kollektiv-backend.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080
