{
  "expo": {
    "name": "Redely",
    "slug": "redely",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ryddigkollektivnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.wilhelmsen.ryddigkollektiv",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wilhelmsen.ryddigkollektiv",
      "adaptiveIcon": {
        "backgroundColor": "#F5EEE1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EAF2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Redely trenger tilgang til bildene dine for å sette profilbilde og sende bilder i chatten.",
          "cameraPermission": "Redely trenger tilgang til kameraet for å ta bilder du sender i chatten."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#C9573F",
          "defaultChannel": "default"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8b85cd7-b26c-4fd5-a001-37eac648301f"
      }
    },
    "owner": "stianwilhelm"
  }
}
